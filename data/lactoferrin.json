// Configuration for the protein-cutting simulator (JSON format, replaces the old XML format).
// Comments (// and /* */) are supported by the loader and stripped before parsing.
{
	// === Simulation parameters ===
	"parameters": {
		// set to a number to get reproducible runs; null = seed from current time
		"randomSeed": null,
		// stop condition: stop after maximum number of iterations reached
		"maxTime": 1200000,
		// stop condition: stop after reaching the given degree of hydrolysis (DH)
		"maxDH": 0.1,
		// how many attempts to cut should the simulated enzyme perform, per iteration
		"maxAttemptsPerTime": 1,
		// stop condition: stop after failing this many consecutive attempts to cut
		"maxAttempts": 1000,

		// THE FOLLOWING THREE ARE EXPERIMENTAL, ADVISE NOT TO MODIFY THEM
		// the enzyme 'dies out' during the process, so it is more effective at the beginning; we thought it could be
		// interesting to have the enzyme reduce its probability of activation during time, but the code is not ready
		"initialEnzyme": 1.0,
		"enzymeAlwaysDying": false,
		"enzymeDyingRatio": 1.0
	},

	// here you can define multiple proteins, each with a number of copies ("quantity").
	// "disulfideBonds" lists 1-indexed positions in the sequence that the enzyme finds harder to cut
	// (not all of them are disulfide bonds, some are glycosylations)
	"proteins": [
		{
			"name": "lactoferrin",
			"quantity": 500,
			"disulfideBonds": [9, 19, 36, 45, 115, 157, 170, 173, 181, 198, 231, 245, 348, 358, 371, 380, 405, 425, 457, 481, 491, 502, 505, 515, 532, 573, 587, 625, 630, 647, 675, 684, 233, 368, 476, 545],
			"sequence": ""
		}
	],

	// basic probabilities of cutting a bond, depending on the aminoacids in position P1 (left) / P1' (right);
	// probabilities here are taken from Hamuro et al., 2008.
	// NOTE: entries with probability 0 are omitted (a missing right-aminoacid means probability 0),
	// matching the original loader, which only stored cuts with probability > 0.
