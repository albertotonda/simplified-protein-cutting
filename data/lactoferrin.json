		"f": { "y": 0.65, "f": 0.85, "w": 0.6, "i": 0.65, "m": 0.83, "v": 0.5, "l": 0.64, "c": 0.2, "a": 0.55, "e": 0.42, "d": 0.44, "r": 0.42, "n": 0.42, "s": 0.52, "t": 0.31, "h": 0.43, "k": 0.47, "q": 0.33, "p": 0.17, "g": 0.28 },
