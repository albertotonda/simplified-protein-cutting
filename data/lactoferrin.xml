<configuration>

	<parameters>
		<!-- activate/deactivate fixed random seed -->
		<!-- <randomSeed value="42"/> -->
		<maxTime value="1200000"/> <!-- stop condition: stop after maximum time reached (in seconds) -->
		<maxDH value="0.10"/> <!-- stop condition: stop after reaching the given degree of hydrolysis (DH) -->
		<maxAttemptsPerTime value="1"/> <!-- how many attempts to cut should the simulated pepsin perform, per iteration -->
		<maxAttempts value="1000"/> <!-- stop condition: stop after failing this many consecutive attempts to cut -->

		<!-- THE FOLLOWING THREE LINES ARE EXPERIMENTAL, I ADVISE TO NOT MODIFY THEM
			pepsin 'dies out' during the process, so it is more effective at the beginning; we thought it could be
			interesting to have pepsin reduce its probability of activation during time, but the code is not ready
		-->
		<initialPepsin value="1.0"/>  
		<pepsinAlwaysDying value="false"/>
		<pepsinDyingRatio value="1.0"/>
	</parameters>

	<!-- 	here you can define multiple proteins, each one with a number of copies (attribute "quantity"). Proteins also have places that pepsin finds it
		harder to cut, their positions (starting from index 0) are in the attribute 'disulfideBonds', even if not all of them are disulfide bonds,
		some are glycolysations
